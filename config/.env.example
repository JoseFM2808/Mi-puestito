# ============================================================
# Plantilla de variables de entorno — SIN valores reales.
# Copiar a:  config/.env.staging     (local / pruebas)
#            config/.env.production  (despliegue real)
# Ambos están en .gitignore: jamás se versionan.
#
# Arranque en Staging:
#   cd backend && uvicorn main:app --reload --env-file ../config/.env.staging
# (uvicorn[standard] ya incluye python-dotenv para leer --env-file)
# ============================================================

# ---- Base de datos ----
# Vacío = un SQLite por proyecto en la carpeta de datos (recomendado en Staging).
# Producción en nube: postgresql+psycopg://usuario:CLAVE@host:5432/mi_puestito
MI_PUESTITO_BD=

# ---- CORS: orígenes permitidos (coma) ----
MI_PUESTITO_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# ---- Seguridad ----
# Firma de los tokens de sesión. Vacío = se genera al azar en cada arranque
# (las sesiones vencen al reiniciar). En producción: 64 hex aleatorios,
#   python -c "import secrets; print(secrets.token_hex(32))"
MI_PUESTITO_SECRETO=
# PIN del proyecto real. Vacío = se genera y se muestra UNA vez en consola.
MI_PUESTITO_ANITA_PIN=

# ---- Capa de IA (agnóstica al proveedor, ADR-036) ----
# Lo más simple en Staging: powershell -ExecutionPolicy Bypass -File scripts\staging-con-ia.ps1
# (pide la llave oculta, verifica los modelos y arranca). NUNCA pegues la llave en este archivo
# si lo vas a compartir: config/.env.* está ignorado, pero la llave vive mejor en tu usuario de Windows.
MI_PUESTITO_IA_PROVEEDOR=nvidia          # nvidia | local (Ollama / llama.cpp)
MI_PUESTITO_IA_URL=                      # vacío = la del proveedor (local: http://127.0.0.1:11434/v1)
NVIDIA_API_KEY=
MI_PUESTITO_IA_API_KEY=                  # solo si un proveedor local la pide
# Vacío = el orden que dejó `python -m ia.verificar` (recomendado) o la lista por defecto
MI_PUESTITO_IA_MODELOS=
MI_PUESTITO_IA_TIMEOUT=12
# Registro seudonimizado para un futuro fine-tuning (ADR-038): vacío | demo | todos
MI_PUESTITO_IA_REGISTRO=

# ---- Carpeta de datos (opcional) ----
# Staging: fuera del repo, p. ej. C:\Users\<tu-usuario>\AppData\Local\MiPuestito-staging
MI_PUESTITO_DATOS=
MI_PUESTITO_ENTORNO=local                # local | production (production exige MI_PUESTITO_SECRETO)
