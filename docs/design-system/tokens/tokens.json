{
  "$description": "Mi Puestito · núcleo de marca, paleta A \"Mercado\". Fuente del estándar de Design System (ADR-048). docs/06-diseno/tokens.css sigue siendo lo que importa el frontend (@tokens); el validador avisa si se separan.",
  "$extensions": {
    "pe.proyectos-ia": {
      "proyecto": "Mi-puestito",
      "tema": "claro",
      "css_producto": [
        {
          "archivo": "docs/06-diseno/tokens.css",
          "formato": "css"
        }
      ]
    }
  },
  "color": {
    "$type": "color",
    "fondo": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9804,
          0.9686,
          0.949
        ],
        "hex": "#FAF7F2"
      },
      "$description": "Blanco hueso cálido: no brilla bajo luz natural",
      "$extensions": {
        "pe.proyectos-ia": {
          "alias": [
            "--fondo"
          ]
        }
      }
    },
    "superficie": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#FFFFFF"
      },
      "$description": "Tarjetas, barra superior, campos",
      "$extensions": {
        "pe.proyectos-ia": {
          "alias": [
            "--superficie"
          ]
        }
      }
    },
    "tinta": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1686,
          0.149,
          0.1255
        ],
        "hex": "#2B2620"
      },
      "$description": "Marrón casi negro: contraste alto sin dureza",
      "$extensions": {
        "pe.proyectos-ia": {
          "alias": [
            "--texto"
          ]
        }
      }
    },
    "texto": {
      "$value": "{color.tinta}"
    },
    "texto-suave": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4314,
          0.3882,
          0.3412
        ],
        "hex": "#6E6357"
      },
      "$description": "Notas y rótulos secundarios",
      "$extensions": {
        "pe.proyectos-ia": {
          "alias": [
            "--texto-suave"
          ]
        }
      }
    },
    "linea": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9098,
          0.8784,
          0.8314
        ],
        "hex": "#E8E0D4"
      },
      "$description": "Bordes suaves de tarjetas",
      "$extensions": {
        "pe.proyectos-ia": {
          "alias": [
            "--borde"
          ]
        }
      }
    },
    "accion": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1176,
          0.4314,
          0.2588
        ],
        "hex": "#1E6E42"
      },
      "$description": "Verde billete: acciones principales e ingresos",
      "$extensions": {
        "pe.proyectos-ia": {
          "alias": [
            "--primario"
          ]
        }
      }
    },
    "sobre-accion": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "hex": "#FFFFFF"
      }
    },
    "acento": {
      "$value": "{color.accion}",
      "$description": "Lo que hay que recordar va en el mismo verde"
    },
    "sobre-acento": {
      "$value": "{color.sobre-accion}"
    },
    "exito": {
      "$value": "{color.accion}",
      "$description": "Entra dinero"
    },
    "aviso": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.7059,
          0.3725,
          0.0235
        ],
        "hex": "#B45F06"
      },
      "$description": "Ámbar tierra: por cobrar, órdenes abiertas",
      "$extensions": {
        "pe.proyectos-ia": {
          "alias": [
            "--pendiente"
          ]
        }
      }
    },
    "peligro": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6392,
          0.2275,
          0.1804
        ],
        "hex": "#A33A2E"
      },
      "$description": "Rojo ladrillo: fiado, vencidos, errores",
      "$extensions": {
        "pe.proyectos-ia": {
          "alias": [
            "--deuda"
          ]
        }
      }
    },
    "info": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.3529,
          0.5412
        ],
        "hex": "#1A5A8A"
      },
      "$description": "Azul del Asistente: el único color fuera de la lógica del dinero",
      "$extensions": {
        "pe.proyectos-ia": {
          "alias": [
            "--ia"
          ]
        }
      }
    }
  },
  "tipo": {
    "$type": "fontFamily",
    "cuerpo": {
      "$value": [
        "Lexend",
        "sans-serif"
      ],
      "$description": "Familia única: mejora la lectura con baja fluidez lectora",
      "$extensions": {
        "pe.proyectos-ia": {
          "alias": [
            "--fuente"
          ]
        }
      }
    },
    "display": {
      "$value": "{tipo.cuerpo}"
    },
    "datos": {
      "$value": "{tipo.cuerpo}",
      "$description": "Montos en Lexend con números tabulares"
    }
  },
  "radio": {
    "$type": "dimension",
    "s": {
      "$value": {
        "value": 11,
        "unit": "px"
      },
      "$extensions": {
        "pe.proyectos-ia": {
          "alias": [
            "--radio-chico"
          ]
        }
      }
    },
    "m": {
      "$value": {
        "value": 14,
        "unit": "px"
      },
      "$extensions": {
        "pe.proyectos-ia": {
          "alias": [
            "--radio"
          ]
        }
      }
    },
    "l": {
      "$value": "{radio.m}"
    }
  }
}
