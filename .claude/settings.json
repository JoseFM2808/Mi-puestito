{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run build)"
    ],
    "deny": [
      "Read(./config/.env.*)",
      "Read(./**/.env)",
      "Read(./**/usuarios.json)",
      "Read(./**/*.db)",
      "Read(./**/*.jsonl)"
    ]
  }
}
